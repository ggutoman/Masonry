<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardElevation="10dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:id="@+id/scv_form"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btn_create">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Text_Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="Membership Information"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.6dp"
                android:layout_marginVertical="10dp"
                android:background="@android:color/darker_gray"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/material_text_background">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Text_Header"
                    android:id="@+id/mtv_member_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Member Details"
                    android:padding="20dp"
                    app:layout_constraintWidth_percent="0.8"/>

                <ImageButton
                    style="@style/Text_Header"
                    android:id="@+id/btn_download"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/baseline_download"
                    android:paddingVertical="20dp"
                    android:backgroundTint="@android:color/transparent"
                    android:visibility="gone"
                    app:layout_constraintStart_toEndOf="@+id/mtv_member_label"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/layout_member"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="5dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="15sp">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/mtv_generate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Create ALSM ID"
                        android:textColor="?attr/colorPrimary"
                        android:paddingHorizontal="10dp"
                        android:paddingBottom="5dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintWidth_percent="0.5"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/mtv_resend"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Resend ALSM ID"
                        android:gravity="end"
                        android:textColor="?attr/colorPrimary"
                        android:visibility="gone"
                        android:paddingHorizontal="10dp"
                        android:paddingBottom="5dp"
                        app:layout_constraintTop_toTopOf="@+id/mtv_generate"
                        app:layout_constraintBottom_toBottomOf="@+id/mtv_generate"
                        app:layout_constraintStart_toEndOf="@+id/mtv_generate"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/TextInputStyle"
                        android:id="@+id/til_alsm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="ALSM ID"
                        app:layout_constraintTop_toBottomOf="@+id/mtv_generate"
                        app:layout_constraintStart_toStartOf="@+id/mtv_generate"
                        app:layout_constraintEnd_toEndOf="@+id/mtv_resend">

                        <com.google.android.material.textfield.TextInputEditText
                            style="@style/TextInputStyle.Edittext"
                            android:id="@+id/tie_glpid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/mtv_alsm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Save"
                        android:gravity="end"
                        android:textColor="?attr/colorPrimary"
                        android:layout_margin="10dp"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@+id/til_alsm"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/TextInputStyle"
                    android:id="@+id/til_dMbr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Date of Membership">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/TextInputStyle.Edittext"
                        android:id="@+id/tie_dMbr"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/baseline_edit_calendar_24"
                        android:focusable="false"
                        android:clickable="true"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/TextInputStyle"
                    android:id="@+id/til_intn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Date of Initiation">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/TextInputStyle.Edittext"
                        android:id="@+id/tie_intn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/baseline_edit_calendar_24"
                        android:focusable="false"
                        android:clickable="true"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/TextInputStyle"
                    android:id="@+id/til_passing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Date of Passing">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/TextInputStyle.Edittext"
                        android:id="@+id/tie_passing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/baseline_edit_calendar_24"
                        android:focusable="false"
                        android:clickable="true"/>

                </com.google.android.material.textfield.TextInputLayout>


                <com.google.android.material.textfield.TextInputLayout
                    style="@style/TextInputStyle"
                    android:id="@+id/til_raising"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Date of Raising">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/TextInputStyle.Edittext"
                        android:id="@+id/tie_raising"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/baseline_edit_calendar_24"
                        android:focusable="false"
                        android:clickable="true"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/TextInputStyle"
                    android:id="@+id/til_suspend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Date of Suspension"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/TextInputStyle.Edittext"
                        android:id="@+id/tie_suspend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/baseline_edit_calendar_24"
                        android:focusable="false"
                        android:clickable="true"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/CustomDropDownTilStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Status (Required)">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        style="@style/DropdownStyleTheme"
                        android:id="@+id/auto_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <com.google.android.material.textview.MaterialTextView
                style="@style/Text_Header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Personal Details"
                android:paddingVertical="20dp"
                android:paddingHorizontal="10dp"
                android:layout_margin="5dp"
                android:background="@color/material_text_background"/>

            <LinearLayout
                android:id="@+id/layout_personal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="5dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/TextInputStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Lastname  (Required)">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/TextInputStyle.Edittext"
                        android:id="@+id/tie_lastname"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/TextInputStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Firstname  (Required)">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/TextInputStyle.Edittext"
                        android:id="@+id/tie_firstname"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </com.google.android.material.textfield.TextInputLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/TextInputStyle"
                        android:id="@+id/til_midname"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="Middlename"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintWidth_percent="0.7">

                        <com.google.android.material.textfield.TextInputEditText
                            style="@style/TextInputStyle.Edittext"
                            android:id="@+id/tie_middlename"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/TextInputStyle"
                        android:id="@+id/til_suffix"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="Suffix"
                        app:layout_constraintStart_toEndOf="@+id/til_midname"
                        app:layout_constraintTop_toTopOf="@+id/til_midname"
                        app:layout_constraintBottom_toBottomOf="@+id/til_midname"
                        app:layout_constraintEnd_toEndOf="parent">

                        <com.google.android.material.textfield.TextInputEditText
                            style="@style/TextInputStyle.Edittext"
                            android:id="@+id/tie_suffix"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                    </com.google.android.material.textfield.TextInputLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/CustomDropDownTilStyle"
                    android:id="@+id/til_civil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Civil Status  (Required)"
                    app:layout_constraintStart_toEndOf="@+id/til_midname"
                    app:layout_constraintTop_toTopOf="@+id/til_midname"
                    app:layout_constraintBottom_toBottomOf="@+id/til_midname"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        style="@style/DropdownStyleTheme"
                        android:id="@+id/auto_civil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/TextInputStyle"
                    android:id="@+id/til_birthdate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Birthdate">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/TextInputStyle.Edittext"
                        android:id="@+id/tie_birthdate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/baseline_edit_calendar_24"
                        android:focusable="false"
                        android:clickable="true"/>

                </com.google.android.material.textfield.TextInputLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_address_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@color/material_text_background"
                        android:layout_marginTop="10dp"
                        android:padding="15dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Text_Header"
                            android:id="@+id/mtv_address"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Address Information"
                            app:layout_constraintTop_toTopOf="@+id/btn_add_address"
                            app:layout_constraintBottom_toBottomOf="@+id/btn_add_address"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/btn_add_address"/>

                        <ImageButton
                            android:id="@+id/btn_add_address"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/baseline_add_circle_24"
                            android:backgroundTint="@android:color/transparent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:tint="@color/material_pale_yellow" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/CustomDropDownTilStyle"
                        android:id="@+id/til_town"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="Select Address"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layout_address_label">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/auto_town"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/TextInputStyle"
                        android:id="@+id/til_address"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="Address"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/til_town">

                        <com.google.android.material.textfield.TextInputEditText
                            style="@style/TextInputStyle.Edittext"
                            android:id="@+id/tie_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        style="@style/Material_Button_Transparent"
                        android:id="@+id/btn_save_address"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Save"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@+id/til_address"/>

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/chkbx_homeaddr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Home"
                        android:layout_marginHorizontal="10dp"
                        app:layout_constraintTop_toBottomOf="@+id/til_address"
                        app:layout_constraintEnd_toStartOf="@+id/chkbx_active"/>

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/chkbx_active"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active"
                        android:layout_marginEnd="10dp"
                        app:layout_constraintTop_toBottomOf="@+id/til_address"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_contact_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@color/material_text_background"
                        android:layout_marginTop="10dp"
                        android:padding="10dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Text_Header"
                            android:id="@+id/mtv_contact"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Contact Information"
                            app:layout_constraintTop_toTopOf="@+id/btn_add_contact"
                            app:layout_constraintBottom_toBottomOf="@+id/btn_add_contact"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/btn_add_contact"/>

                        <ImageButton
                            android:id="@+id/btn_add_contact"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/baseline_add_circle_24"
                            android:backgroundTint="@android:color/transparent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:tint="@color/material_pale_yellow" />


                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/CustomDropDownTilStyle"
                        android:id="@+id/til_contact"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="Select Contact"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layout_contact_label">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/auto_contact"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/TextInputStyle"
                        android:id="@+id/til_remarks"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="Additional Information (Optional)"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/til_contact">

                        <com.google.android.material.textfield.TextInputEditText
                            style="@style/TextInputStyle.Edittext"
                            android:id="@+id/tie_remarks"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        style="@style/Material_Button_Transparent"
                        android:id="@+id/btn_save_contact"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Save"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@+id/til_remarks"/>

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/chkbx_activecontact"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active"
                        android:layout_marginEnd="10dp"
                        app:layout_constraintTop_toBottomOf="@+id/til_remarks"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_email_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@color/material_text_background"
                        android:layout_marginTop="10dp"
                        android:padding="10dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Text_Header"
                            android:id="@+id/mtv_email"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Email Information"
                            app:layout_constraintTop_toTopOf="@+id/btn_add_email"
                            app:layout_constraintBottom_toBottomOf="@+id/btn_add_email"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/btn_add_email"/>

                        <ImageButton
                            android:id="@+id/btn_add_email"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/baseline_add_circle_24"
                            android:backgroundTint="@android:color/transparent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:tint="@color/material_pale_yellow" />


                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/CustomDropDownTilStyle"
                        android:id="@+id/til_email"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="Select Email"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layout_email_label">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/auto_email"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        style="@style/Material_Button_Transparent"
                        android:id="@+id/btn_save_email"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Save"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@+id/til_email"/>

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/chkbx_activeemail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active"
                        android:layout_marginEnd="10dp"
                        app:layout_constraintTop_toBottomOf="@+id/til_email"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <include
                    android:id="@+id/view_modify"
                    android:visibility="gone"
                    layout="@layout/layout_modify"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_create"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Create Member"
        android:layout_margin="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>