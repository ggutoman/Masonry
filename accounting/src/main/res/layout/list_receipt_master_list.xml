<?xml version="1.0" encoding="utf-8"?>
    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:id="@+id/layout_trans"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.5">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Text_Header"
                android:id="@+id/mtv_src_nme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="N/A"/>

            <com.google.android.material.textview.MaterialTextView
                style="@style/Text_Header"
                android:id="@+id/mtv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="N/A"
                android:textSize="13dp"
                android:alpha="0.7"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@+id/layout_trans"
            app:layout_constraintTop_toTopOf="@+id/layout_trans"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.5">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Text_Header"
                android:id="@+id/mtv_src_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0.00"
                android:gravity="end"/>

            <com.google.android.material.textview.MaterialTextView
                style="@style/Text_Header"
                android:id="@+id/mtv_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1900-00-00"
                android:textSize="13sp"
                android:alpha="0.7"
                android:gravity="end"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>