<?xml version="1.0" encoding="utf-8"?>
    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:padding="5dp">

        <com.google.android.material.textview.MaterialTextView
            style="@style/Text_Header"
            android:id="@+id/mtv_date_pledge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="January 01, 1900"
            android:alpha="0.7"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.5"/>

        <com.google.android.material.textview.MaterialTextView
            style="@style/Text_Header"
            android:id="@+id/mtv_amt_pledge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="0.00"
            android:alpha="0.7"
            android:gravity="end"
            app:layout_constraintTop_toTopOf="@+id/mtv_date_pledge"
            app:layout_constraintBottom_toBottomOf="@+id/mtv_date_pledge"
            app:layout_constraintStart_toEndOf="@+id/mtv_date_pledge"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.5"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtv_or_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="OR Number"
            android:alpha="0.7"
            android:layout_marginTop="5dp"
            android:textSize="13sp"
            android:layout_marginStart="2dp"
            app:layout_constraintTop_toBottomOf="@+id/mtv_amt_pledge"
            app:layout_constraintStart_toStartOf="@+id/mtv_date_pledge"
            app:layout_constraintEnd_toEndOf="@+id/mtv_date_pledge"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtv_or"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="N/A"
            android:alpha="0.7"
            app:layout_constraintTop_toBottomOf="@+id/mtv_or_label"
            app:layout_constraintStart_toStartOf="@+id/mtv_or_label"
            app:layout_constraintEnd_toEndOf="@+id/mtv_or_label"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtv_paid_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Amount Paid"
            android:alpha="0.7"
            android:gravity="end"
            android:textSize="13sp"
            android:layout_marginEnd="2dp"
            app:layout_constraintTop_toTopOf="@+id/mtv_or_label"
            app:layout_constraintBottom_toBottomOf="@+id/mtv_or_label"
            app:layout_constraintStart_toStartOf="@+id/mtv_amt_pledge"
            app:layout_constraintEnd_toEndOf="@+id/mtv_amt_pledge"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtv_paid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="N/A"
            android:alpha="0.7"
            android:gravity="end"
            app:layout_constraintTop_toBottomOf="@+id/mtv_paid_label"
            app:layout_constraintStart_toStartOf="@+id/mtv_paid_label"
            app:layout_constraintEnd_toEndOf="@+id/mtv_paid_label"/>

    </androidx.constraintlayout.widget.ConstraintLayout>