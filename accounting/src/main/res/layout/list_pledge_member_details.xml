<?xml version="1.0" encoding="utf-8"?>
    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:padding="5dp">

        <com.google.android.material.textview.MaterialTextView
            style="@style/Text_Header"
            android:id="@+id/mtv_date_pledge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="January 01, 1900"
            android:alpha="0.7"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.5"/>

        <com.google.android.material.textview.MaterialTextView
            style="@style/Text_Header"
            android:id="@+id/mtv_amt_pledge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="0.00"
            android:alpha="0.7"
            android:gravity="end"
            app:layout_constraintTop_toTopOf="@+id/mtv_date_pledge"
            app:layout_constraintBottom_toBottomOf="@+id/mtv_date_pledge"
            app:layout_constraintStart_toEndOf="@+id/mtv_date_pledge"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.5"/>

    </androidx.constraintlayout.widget.ConstraintLayout>