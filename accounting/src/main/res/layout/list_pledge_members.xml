<?xml version="1.0" encoding="utf-8"?>
        <androidx.constraintlayout.widget.ConstraintLayout
            xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_marginTop="10dp"
            android:padding="10dp">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Text_Header"
                android:id="@+id/mtv_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="N/A"
                android:alpha="0.7"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.75"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/mtv_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="View Pledge"
                android:textColor="?attr/colorPrimary"
                android:alpha="0.7"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@+id/mtv_name"
                app:layout_constraintEnd_toEndOf="parent"/>

            <View
                android:id="@+id/view_payment"
                android:layout_width="match_parent"
                android:layout_height="0.6dp"
                android:layout_marginTop="5dp"
                android:background="@android:color/darker_gray"
                app:layout_constraintTop_toBottomOf="@+id/mtv_name"
                app:layout_constraintStart_toStartOf="@+id/mtv_name"
                app:layout_constraintEnd_toEndOf="@+id/mtv_name"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcv_pledge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Payment Details:"
                android:alpha="0.7"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@+id/view_payment"
                app:layout_constraintStart_toStartOf="@+id/view_payment"
                app:layout_constraintEnd_toEndOf="@+id/view_payment"/>

        </androidx.constraintlayout.widget.ConstraintLayout>