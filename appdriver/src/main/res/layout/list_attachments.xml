<?xml version="1.0" encoding="utf-8"?>
    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:orientation="vertical"
        android:padding="10dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/siv_img"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="@+id/layout_trans"
            app:layout_constraintBottom_toBottomOf="@+id/layout_trans"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.2"/>

        <LinearLayout
            android:id="@+id/layout_trans"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="5dp"
            app:layout_constraintStart_toEndOf="@+id/siv_img"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Text_Header"
                android:id="@+id/mtv_doc_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="N/A"
                android:alpha="0.7"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Text_Header"
                    android:id="@+id/mtv_date_transact"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="1900-00-00"
                    android:textSize="13sp"
                    android:alpha="0.7"
                    app:layout_constraintWidth_percent="0.5"/>

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Text_Header"
                    android:id="@+id/mtv_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="N/A"
                    android:textSize="13sp"
                    android:alpha="0.7"
                    android:gravity="end"
                    android:textStyle="italic"
                    app:layout_constraintStart_toEndOf="@+id/mtv_date_transact"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>