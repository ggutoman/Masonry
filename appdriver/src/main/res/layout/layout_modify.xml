<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@+id/view_div"
        android:layout_width="match_parent"
        android:layout_height="0.6dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="10dp"
        android:background="@android:color/darker_gray"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mtv_edit_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Last modified by:"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/view_div"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.5"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mtv_edit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="N/A"
        android:alpha="0.7"
        app:layout_constraintTop_toBottomOf="@+id/mtv_edit_label"
        app:layout_constraintStart_toStartOf="@+id/mtv_edit_label"
        app:layout_constraintEnd_toEndOf="@+id/mtv_edit_label"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mtv_editdt_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Last modification date:"
        android:gravity="end"
        app:layout_constraintTop_toTopOf="@+id/mtv_edit_label"
        app:layout_constraintBottom_toBottomOf="@+id/mtv_edit_label"
        app:layout_constraintStart_toEndOf="@+id/mtv_edit_label"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mtv_editdt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="1900-00-00 00:00:00"
        android:gravity="end"
        android:alpha="0.7"
        app:layout_constraintTop_toBottomOf="@+id/mtv_editdt_label"
        app:layout_constraintStart_toStartOf="@+id/mtv_editdt_label"
        app:layout_constraintEnd_toEndOf="@+id/mtv_editdt_label"
        app:layout_constraintWidth_percent="0.5"/>

</androidx.constraintlayout.widget.ConstraintLayout>