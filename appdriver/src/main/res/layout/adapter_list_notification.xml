<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    app:cardElevation="10dp"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <com.google.android.material.textview.MaterialTextView
            style="@style/Text_Header"
            android:id="@+id/mtv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="No Title"
            android:maxLines="1"
            app:layout_constraintWidth_percent="0.7"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtv_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="View Details"
            android:gravity="end"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintTop_toTopOf="@+id/mtv_title"
            app:layout_constraintBottom_toBottomOf="@+id/mtv_title"
            app:layout_constraintStart_toEndOf="@+id/mtv_title"
            app:layout_constraintEnd_toEndOf="parent"/>

        <View
            android:id="@+id/view_divider"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="?attr/colorOnBackground"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintTop_toBottomOf="@+id/mtv_title"
            app:layout_constraintStart_toStartOf="@+id/mtv_title"
            app:layout_constraintEnd_toEndOf="@+id/mtv_view"
            app:layout_constraintHeight_percent="0.009"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtv_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No message"
            android:maxLines="3"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@+id/view_divider"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>