<?xml version="1.0" encoding="utf-8"?>
    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:orientation="vertical"
        android:padding="10dp">

        <com.google.android.material.textview.MaterialTextView
            style="@style/Text_Header"
            android:id="@+id/mtv_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="N/A"
            android:alpha="0.7"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.7"/>

        <com.google.android.material.textview.MaterialTextView
            style="@style/Text_Header"
            android:id="@+id/mtv_amt_pledge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="0.00"
            android:alpha="0.7"
            android:gravity="end"
            app:layout_constraintTop_toTopOf="@+id/mtv_name"
            app:layout_constraintBottom_toBottomOf="@+id/mtv_name"
            app:layout_constraintStart_toEndOf="@+id/mtv_name"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mtv_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="1900-00-00"
            android:alpha="0.7"
            android:layout_marginTop="5dp"
            android:textSize="13sp"
            android:layout_marginStart="2dp"
            android:gravity="end"
            app:layout_constraintTop_toBottomOf="@+id/mtv_amt_pledge"
            app:layout_constraintStart_toStartOf="@+id/mtv_amt_pledge"
            app:layout_constraintEnd_toEndOf="@+id/mtv_amt_pledge"/>

    </androidx.constraintlayout.widget.ConstraintLayout>