<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.textview.MaterialTextView
        style="@style/Text_Header"
        android:id="@+id/mtv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:text="N/A"
        android:alpha="0.8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mtv_assignee"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="N/A"
        android:textSize="13sp"
        android:alpha="0.7"
        app:layout_constraintTop_toBottomOf="@+id/mtv_name"
        app:layout_constraintStart_toStartOf="@+id/mtv_name"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mtv_dtransact"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="N/A"
        android:textSize="13sp"
        android:alpha="0.7"
        app:layout_constraintTop_toBottomOf="@+id/mtv_assignee"
        app:layout_constraintStart_toStartOf="@+id/mtv_assignee"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ExpandableListView
        android:id="@+id/rcv_details"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:groupIndicator="@null"
        android:divider="@null"
        android:visibility="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mtv_name"/>

</androidx.constraintlayout.widget.ConstraintLayout>